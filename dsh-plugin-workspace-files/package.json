{
  "name": "dsh-plugin-workspace-files",
  "version": "0.1.0",
  "description": "DeepSeek Harness 工作区文件体验插件：输入框 @ 引用文件 + 修改文件点击侧边栏预览 + 右上角项目文件夹浏览。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "dompurify": "^3.4.13"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "workspace",
    "file",
    "mention",
    "preview",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
