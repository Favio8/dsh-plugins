{
  "name": "dsh-plugin-task-notify",
  "version": "0.7.0",
  "description": "DeepSeek Harness 任务完成通知插件：飞书式置顶卡片（主题/强调色/位置/时长/字体可配）+ 可选提示音（苹果三全音等，含音量调节）+ 等待输入/审批提醒 + 应用内 toast + 完整设置页。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-client.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "notification",
    "notify",
    "desktop",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
